{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "chat" },
			"ui": { "position": { "x": 20, "y": 200 }, "measured": { "width": 150, "height": 66 } }
		},
		{
			"id": "prompt_1",
			"provider": "prompt",
			"config": {
				"instructions": [
					"You are an AI resell analyst for Pokemon TCG products. Given a product restock event with retail price, eBay market price, profit margin, demand data, and days since last restock, provide: 1. Recommendation: Buy Now / Buy if Convenient / Skip 2. Demand summary: one sentence 3. Urgency: how fast it will likely sell out 4. Alert message: one natural sentence for Discord. Format as JSON with keys: recommendation, demandSummary, urgency, alertMessage"
				],
				"parameters": {}
			},
			"input": [{ "lane": "questions", "from": "chat_1" }],
			"ui": { "position": { "x": 240, "y": 200 }, "measured": { "width": 150, "height": 66 } }
		},
		{
			"id": "llm_openai_1",
			"provider": "llm_openai",
			"config": {
				"profile": "custom",
				"custom": {
					"apikey": "${ROCKETRIDE_GEMINI_KEY}",
					"model": "gemini-2.0-flash",
					"modelTotalTokens": 32768
				},
				"parameters": {}
			},
			"input": [{ "lane": "questions", "from": "prompt_1" }],
			"ui": { "position": { "x": 460, "y": 200 }, "measured": { "width": 150, "height": 66 } }
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"config": { "laneName": "answers" },
			"input": [{ "lane": "answers", "from": "llm_openai_1" }],
			"ui": { "position": { "x": 680, "y": 200 }, "measured": { "width": 150, "height": 66 } }
		}
	],
	"project_id": "5eab8a60-be9e-4e0a-80a1-8c5059917fb3",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
